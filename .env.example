# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก .gitignore ไว้ ห้าม commit)

# จำเป็น: API key ของ Anthropic (console.anthropic.com -> API keys) ใช้กับสมองของ Jarvis (Claude Haiku)
ANTHROPIC_API_KEY=

# ไม่บังคับ: Picovoice AccessKey เพื่อเรียกแค่ "Jarvis" (ไม่ต้องพูด Hey) ถ้าเว้นว่างจะใช้ "Hey Jarvis" ของ openWakeWord
# (หมายเหตุ: ตอนนี้ Picovoice รับสมัครเฉพาะอีเมลบริษัท)
PICOVOICE_ACCESS_KEY=
